package it.unige.cleaningrobots

event NextCellMovement {
	var x : int
	var y : int

	new(x : int, y : int) {
		this.x = x
		this.y = y
	}
}

event EnvironmentPerception {
	var x : int
	var y : int
	var hasDirt : boolean

	new(x : int, y : int, hasDirt : boolean) {
		this.x = x
		this.y = y
		this.hasDirt = hasDirt
	}
}

event PickGarbage {
	var x : int
	var y : int

	new(x : int, y : int) {
		this.x = x
		this.y = y
	}
}

// DropGarbage ha un payload vuoto, quindi basta la dichiarazione diretta
event DropGarbage
