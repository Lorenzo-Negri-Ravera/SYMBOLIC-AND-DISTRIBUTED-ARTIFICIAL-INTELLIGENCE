package it.unige.cleaningrobots

import io.sarl.api.core.Initialize
import io.sarl.api.core.Logging
import io.sarl.api.core.DefaultContextInteractions

agent IncineratorAgent {
	uses Logging, DefaultContextInteractions

	var garbage_burned = 0

	on Initialize {
		info("INCINERATOR: Incinerator Agent is online and ready to burn garbage.")
	}

	on DropGarbage {
		garbage_burned++
		info("RECEIVED GARBAGE: Garbage burned. Total garbage destroyed so far: " + garbage_burned)
	}
}